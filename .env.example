# ── LLM Inference Provider ──────────────────────────────────────────────────
# Required: OpenRouter API key for LLM routing (OpenAI, Anthropic, Meta, etc.)
OPENROUTER_API_KEY=sk-or-v1-...

# ── API Security & JWT Authentication ───────────────────────────────────────
# Required: Shared secret key for JWT token encoding/decoding (min 32 chars)
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=smartroute-documents

# ── RAG Embeddings & Reranker ───────────────────────────────────────────────
# Required: Hugging Face User Access Token for local/remote embeddings & reranking
HF_TOKEN=hf_...

# Optional: Enable local ONNX sparse model loading (set false on free tier memory limits)
ENABLE_SPARSE_EMBEDDINGS=false

# ── Vector DB (Qdrant) ──────────────────────────────────────────────────────
# Required: Qdrant vector database URL (local or cloud)
QDRANT_URL=http://localhost:6333
# Optional: Qdrant API key (required if using Qdrant Cloud)
QDRANT_API_KEY=

# ── Redis Cache & History ───────────────────────────────────────────────────
# Required: Redis connection URL (local or Upstash)
REDIS_URL=redis://localhost:6379/0

# ── Relational DB (PostgreSQL / Supabase) ──────────────────────────────────
# Required: PostgreSQL connection string for cost logging and user metrics
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# Runtime behavior
# Render injects PORT automatically. Local default is 8000.
PORT=8000
ENVIRONMENT=development
APP_PUBLIC_URL=http://localhost:8000
DOCUMENTS_DIR=data/documents
# Same-origin production can leave this empty. Add local dev origins when running Vite.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000

# ── Cost Budgets (USD) ─────────────────────────────────────────────────────
DAILY_BUDGET=10.0
WEEKLY_BUDGET=50.0
MONTHLY_BUDGET=200.0

# ── Observability (LangFuse) ───────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
OTEL_EXPORTER_OTLP_ENDPOINT=https://cloud.langfuse.com/api/public/otel
OTEL_SERVICE_NAME=smartroute-ai
