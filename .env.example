LLM_PROVIDER=groq
LLM_API_KEY=replace-with-new-groqcloud-key

SUPABASE_JWT_SECRET=replace-with-new-random-64-character-secret
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-new-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=smartroute-documents

RERANKER_MODE=local
FASTEMBED_CACHE_PATH=

ENABLE_SPARSE_EMBEDDINGS=false

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=replace-with-new-qdrant-database-api-key

REDIS_URL=redis://localhost:6379/0

DATABASE_URL=postgresql://postgres:replace-with-new-password@localhost:5432/postgres

PORT=8000
ENVIRONMENT=development
APP_PUBLIC_URL=http://localhost:8000
MAX_DOCUMENT_UPLOAD_BYTES=10485760
REFERENCE_CENTROIDS_PATH=data/models/reference_centroids.npy
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000
DEMO_TOKEN_TTL_SECONDS=21600

WEBHOOK_URL=

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
OTEL_EXPORTER_OTLP_ENDPOINT=https://cloud.langfuse.com/api/public/otel/v1/traces
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=smartroute-ai
